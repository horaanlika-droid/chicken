  "shots": [
    { "id": "S01", "title": "Домофон", "start": 0, "end": 10, "location": "entrance", "motion": "press", "showCourier": false, "showPovHand": true, "description": "POV: жмёт кнопку. Домофон молчит; дверь открывается от руки.", "voice": "Бля, это когда-нибудь закончится? А чё домофон не работает?" },
    { "id": "S02", "title": "Лестница", "start": 10, "end": 20, "location": "stairs", "motion": "walk", "showCourier": true, "showPovHand": false, "description": "Следуем сзади: подъём, прыгающий жёлтый рюкзак, номера этажей.", "voice": "Шестнадцать, семнадцать, восемнадцать, девятнадцать… Так, стоп, не тот подъезд." },
    { "id": "S03", "title": "Осознание", "start": 20, "end": 30, "location": "stairs", "motion": "turn", "showCourier": true, "showPovHand": false, "description": "Остановка на площадке; голова медленно поворачивается вниз.", "voice": "Зачем поднимался только? Калории тратил. Калории…" },
    { "id": "S04", "title": "Жёлтый куб", "start": 30, "end": 42, "location": "stairs", "motion": "idle", "showCourier": true, "showPovHand": false, "description": "Макрокадр термосумки, ладонь касается куба; усталый профиль.", "voice": "Покажи мне калорию! Как я устал от этих подъездов. Сумка эта. Ебаный жёлтый куб с чужой едой. Блять…" },
    { "id": "S05", "title": "Вверх", "start": 42, "end": 54, "location": "stairs", "motion": "gesture", "showCourier": true, "showPovHand": false, "description": "Низкий ракурс на бесконечную лестницу; свободная рука в жесте.", "voice": "Кто эти лестницы конструировал?! Ааа…" },
    { "id": "S06", "title": "Падение", "start": 54, "end": 68, "location": "impact", "motion": "idle", "showCourier": false, "showPovHand": false, "description": "Удар за кадром. Только жёлтая сумка и почти обрезанная неподвижная фигура.", "voice": "" },
    { "id": "S07", "title": "Кто я?", "start": 68, "end": 80, "location": "reveal", "motion": "idle", "showCourier": false, "showPovHand": false, "description": "Вид сверху: тело, сумка и ноги курьера у затылка. Чёрный экран в конце.", "voice": "Кто-то оставил в нём курьерскую термосумку с моим именем. Кто-то лежит возле неё. Я ровно над его затылком. А кто я?!" }
